{
  "name": "@conventions/cli",
  "version": "0.3.1",
  "description": "`conventions`: check a project against its conventions profile, lint with every tool at once, explain a rule, init and sync a project. Profile-agnostic; the profile package (e.g. @conventions/nextjs) describes the project shape.",
  "type": "module",
  "bin": {
    "conventions": "./bin/conventions.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./architecture": "./src/architecture.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.51.0",
    "@ls-lint/ls-lint": "^2.3.0",
    "tinyglobby": "^0.2.0",
    "yaml": "^2.6.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
